---
import { getLang, t, path } from '../i18n';
const lang = getLang(Astro.url);
const ui = t(lang);
const year = new Date().getFullYear();
---
<footer class="s-encre overflow-hidden px-6 pb-10 pt-12 text-ivoire-muted md:pt-16">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <img src="/brand/logo-empile-ivoire.png" alt="Car Sitting" width="504" height="308" loading="lazy" class="h-24 w-auto md:h-28" />
        <p class="mt-8 max-w-sm font-serif text-3xl font-light italic leading-snug text-ivoire">{ui.signature}</p>
      </div>
      <nav class="md:col-span-3" aria-label={ui.footerNav}>
        <p class="label mb-6">{ui.house}</p>
        <ul class="space-y-3 text-[15px]">
          <li><a href={path('home', lang)} class="footer-link">{ui.home}</a></li>
          {ui.nav.map(({ key, label }) => <li><a href={path(key, lang)} class="footer-link first-letter:uppercase">{label}</a></li>)}
          <li><a href={path('quote', lang)} class="footer-link">{ui.quote}</a></li>
        </ul>
      </nav>
      <div class="md:col-span-4">
        <p class="label mb-6">{ui.contact}</p>
        <ul class="space-y-3 text-[15px]">
          <li>14 rue Charles V<br />75004 Paris</li>
          <li><a href="mailto:contact@carsitting.fr" class="footer-link">contact@carsitting.fr</a></li>
          <li><a href="tel:+33783938318" class="footer-link">07 83 93 83 18</a><br /><a href="tel:+33783767445" class="footer-link">07 83 76 74 45</a></li>
        </ul>
        <p class="label mb-6 mt-10">{ui.follow}</p>
        <ul class="flex gap-8 text-[15px]">
          <li><span class="footer-link">Instagram</span></li>
          <li><span class="footer-link">LinkedIn</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-or/20 pt-8 text-xs tracking-wide text-ivoire/45 md:flex-row md:justify-between">
      <p>© {year} CarSitting · {ui.rights}</p>
      <a href={path('legal', lang)} class="footer-link">{ui.legal}</a>
    </div>
  </div>
</footer>
