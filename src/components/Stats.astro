---
const stats = [["MMXVI","Maison fondée"],["12 000+","Prestations réalisées"],["40+","Établissements servis"]];
---
<section class="s-or px-6 py-24 md:py-32">
  <div class="mx-auto max-w-5xl grid gap-10 md:grid-cols-3 text-center">
    {stats.map(([v,l]) => <div class="border border-nuit/20 bg-ivoire/90 px-6 py-10"><p data-stat class="font-serif text-5xl text-nuit">{v}</p><p class="label mt-3 !text-or">{l}</p></div>)}
  </div>
</section>
