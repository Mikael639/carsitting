<Base title={copy.title} description={copy.description}>
  {/* Ouverture sobre : pas de photo, un titre et l'ornement de la charte. data-hero pour l'apparition en douceur. */}
  <section data-hero class="s-nuit px-6 pb-16 pt-36 text-center md:pb-24 md:pt-48">
    <p class="label hero-reveal mb-8">{copy.label}</p>
    <h1 class="display hero-reveal">{copy.h1}</h1>
    <div class="hero-reveal"><Ornament /></div>
  </section>

  <section class="s-ivoire px-6 py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Sommaire : visible à partir de 1024 px, il reste à l'écran pendant la lecture. */}
      <nav class="hidden lg:col-span-3 lg:block" aria-label={copy.toc}>
        <div class="sticky top-32">
          <p class="label mb-6">{copy.toc}</p>
          <ol class="space-y-4 border-l border-or/35 pl-6">
            {copy.sections.map(([n, title], i) => (
              <li><a href={`#section-${i + 1}`} class="legal-toc"><span class="mr-3 font-serif italic text-or">{n}</span>{title}</a></li>
            ))}
          </ol>
        </div>
      </nav>

      <div class="lg:col-span-9">
        {copy.note && <p class="mb-10 border-l border-or/35 pl-6 text-sm italic text-ivoire-muted">{copy.note}</p>}

        {/* Identité de l'éditeur : les informations que la loi impose de rendre accessibles. Aucune coordonnée bancaire. */}
        <article class="mb-16 border border-encre/10 p-6 md:mb-20 md:p-10">
          <h2 class="font-serif text-3xl font-normal leading-tight text-nuit">{copy.factsTitle}</h2>
          <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-[14rem_1fr]">
            {copy.facts.map(([k, v]) => (
              <>
                <dt class="label !text-or sm:pt-1">{k}</dt>
                <dd class="text-[17px] leading-relaxed text-nuit">
                  {v === 'mail'
                    ? <>
                        <a class="legal-link" href="mailto:contact@carsitting.fr">contact@carsitting.fr</a><br />
                        <a class="legal-link" href="tel:+33783938318">07 83 93 83 18</a> · <a class="legal-link" href="tel:+33783767445">07 83 76 74 45</a>
                      </>
                    : v}
                </dd>
              </>
            ))}
          </dl>
        </article>

        <div class="space-y-16 md:space-y-20">
          {copy.sections.map(([n, title, paras], i) => (
            <article id={`section-${i + 1}`} class="scroll-mt-32">
              <div class="flex items-baseline gap-5">
                <span class="font-serif text-4xl font-light italic text-or">{n}</span>
                <h2 class="font-serif text-[28px] font-normal leading-tight text-nuit md:text-[34px]">{title}</h2>
              </div>
              <div class="mt-8 space-y-5 text-[17px] leading-[1.8] text-ivoire-muted md:pl-[3.25rem]">
                {(paras as string[]).map((p) => <p set:html={p} />)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
