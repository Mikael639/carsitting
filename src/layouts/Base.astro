---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  /** Image de partage (chemin depuis /public), 1200×630 recommandé. */
  image?: string;
  imageAlt?: string;
  /** Pour garder une page hors des moteurs de recherche. */
  noindex?: boolean;
}
const {
  title,
  description = "CarSitting, voituriers premium à Paris : une présence discrète et irréprochable pour hôtels, restaurants et événements privés.",
  image = '/og-image.jpg',
  imageAlt = 'CarSitting — service voiturier à Paris',
  noindex = false,
} = Astro.props;

// URL absolue : indispensable pour les aperçus (Facebook, LinkedIn, WhatsApp, X…).
const site = Astro.site ?? new URL('https://carsitting.fr');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'CarSitting',
  description,
  url: site.href,
  logo: new URL('/favicon.svg', site).href,
  image: imageUrl,
  areaServed: 'Paris',
  email: 'contact@carsitting.fr',
  slogan: 'La juste impression, à chaque fois.',
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#1B2340" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph : Facebook, LinkedIn, WhatsApp, iMessage, Slack, Discord… -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CarSitting" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400&display=swap" rel="stylesheet" />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Header transition:persist />
    <MobileMenu />
    <div class="cursor" id="cursor" aria-hidden="true" transition:persist></div>
    <main transition:animate="none"><slot /></main>
    <Footer />
    <script>
      import { initMotion, cleanupMotion } from '../scripts/motion';
      import { initMenu } from '../scripts/menu';
      import { initCursor } from '../scripts/cursor';
      document.addEventListener('astro:before-swap', cleanupMotion);
      document.addEventListener('astro:page-load', initMotion);
      initMenu();
      initCursor();
    </script>
  </body>
</html>
