---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import '../styles/global.css';
import { getLang, alternates, t } from '../i18n';
interface Props {
  title: string;
  description?: string;
  /** Image de partage (chemin depuis /public), 1200×630 recommandé. */
  image?: string;
  imageAlt?: string;
  /** Pour garder une page hors des moteurs de recherche. */
  noindex?: boolean;
}
const lang = getLang(Astro.url);
const defaults = {
  fr: { description: "CarSitting, voituriers premium à Paris : une présence discrète et irréprochable pour hôtels, restaurants et événements privés.", imageAlt: 'CarSitting — service voiturier à Paris' },
  en: { description: 'CarSitting, premium valets in Paris: a discreet, impeccable presence for hotels, restaurants and private events.', imageAlt: 'CarSitting — valet service in Paris' },
}[lang];
const {
  title,
  description = defaults.description,
  image = '/og-image.jpg',
  imageAlt = defaults.imageAlt,
  noindex = false,
} = Astro.props;

// URL absolue : indispensable pour les aperçus (Facebook, LinkedIn, WhatsApp, X…).
const site = Astro.site ?? new URL('https://carsitting.fr');
const canonical = new URL(Astro.url.pathname, site).href;
// Équivalents de la page dans les deux langues (Google, sélecteur de langue).
const alt = alternates(Astro.url);
const altUrl = { fr: new URL(alt.fr, site).href, en: new URL(alt.en, site).href };
const imageUrl = new URL(image, site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'CarSitting',
  description,
  url: site.href,
  logo: new URL('/brand/icon-512.png', site).href,
  image: imageUrl,
  legalName: 'CARSITTING SAS',
  vatID: 'FR45812982619',
  telephone: ['+33783938318', '+33783767445'],
  address: { '@type': 'PostalAddress', streetAddress: '14 rue Charles V', postalCode: '75004', addressLocality: 'Paris', addressCountry: 'FR' },
  areaServed: 'Paris',
  email: 'contact@carsitting.fr',
  slogan: t(lang).signature,
  inLanguage: lang === 'fr' ? 'fr-FR' : 'en-GB',
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={altUrl.fr} />
    <link rel="alternate" hreflang="en" href={altUrl.en} />
    <link rel="alternate" hreflang="x-default" href={altUrl.fr} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#1B2340" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-192.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph : Facebook, LinkedIn, WhatsApp, iMessage, Slack, Discord… -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CarSitting" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Header transition:persist={`header-${lang}`} />
    <MobileMenu />
    <div class="cursor" id="cursor" aria-hidden="true" transition:persist></div>
    <main transition:animate="none"><slot /></main>
    <Footer />
    <script>
      import { initMotion, cleanupMotion } from '../scripts/motion';
      import { initMenu } from '../scripts/menu';
      import { initCursor } from '../scripts/cursor';
      document.addEventListener('astro:before-swap', cleanupMotion);
      document.addEventListener('astro:page-load', initMotion);
      initMenu();
      initCursor();
    </script>
  </body>
</html>
