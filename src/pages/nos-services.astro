---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import Cta from '../components/Cta.astro';
const prestations = [
  ["I","Hôtels","Un accueil sans rupture, du perron à la chambre. Gestion continue des arrivées et des départs, présence discrète, coordination avec votre réception.","/images/services-hotel.jpg","Piscine et façade d’un hôtel parisien"],
  ["II","Restaurants","Une dépose précise et une circulation fluide aux heures de pointe. Vos clients accueillis, vos abords dégagés, aucun frottement visible.","/images/services-restaurant.webp","Terrasse de restaurant face à la tour Eiffel"],
  ["III","Événements privés","Via votre établissement, un dispositif sur-mesure : équipe dimensionnée, arrivées multiples orchestrées, un protocole invisible pour vos invités.","/images/services-evenement.jpg","Voituriers accueillant une invitée lors d’une soirée privée"],
];
const formules = [["À l’année","Une présence intégrée au rythme de votre maison."],["Ponctuel","Une équipe préparée pour vos séquences choisies."],["Événementiel","Un protocole calibré pour vos temps forts."]];
---
<Base
  title="Nos services — CarSitting"
  description="Un service voiturier décliné pour chaque maison : hôtels, restaurants et événements privés. À l’année, ponctuel ou événementiel, avec le même niveau d’exigence."
>
  <Hero
    slides={[{ src: '/images/services-evenement.jpg', position: 'center 35%' }]}
    label="Nos services"
    title="Un service, décliné pour chaque maison."
    quote="Le même standard d’excellence, adapté à la nature de votre établissement."
    cta={{ href: '/demander-un-devis', label: 'Demander un devis' }}
  />

  <section class="s-ivoire px-6 pb-20 pt-32 text-center md:pb-28 md:pt-48">
    <p class="label mb-10">Notre philosophie</p>
    <h2 class="quote-xl mx-auto max-w-4xl not-italic">Un seul niveau d’exigence, quelle que soit la prestation.</h2>
    <p class="lede mx-auto mt-10 text-ivoire-muted">De l’arrivée d’un hôte à la fin d’une soirée, chaque geste est tenu avec la même précision. Votre maison reste au premier plan.</p>
  </section>

  <!-- Prestations : grandes images, alternées gauche / droite. -->
  <section class="s-ivoire px-6 pb-32 md:pb-48">
    <div class="mx-auto max-w-7xl space-y-28 md:space-y-40">
      {prestations.map(([n, t, d, src, alt], i) => (
        <article class="card grid items-center gap-10 md:grid-cols-12 md:gap-10">
          <div class:list={['card-media overflow-hidden md:col-span-7', i % 2 === 1 && 'md:order-2 md:col-start-6']}>
            <img src={src} alt={alt} loading="lazy" class="aspect-[4/3] w-full object-cover md:aspect-[5/4]" />
          </div>
          <div class:list={['md:col-span-4', i % 2 === 1 ? 'md:order-1 md:col-start-1' : 'md:col-start-9']}>
            <p class="font-serif text-6xl font-light italic text-or">{n}</p>
            <h3 class="mt-6 font-serif text-4xl font-normal leading-tight text-nuit">{t}</h3>
            <p class="mt-5 text-ivoire-muted">{d}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="s-nuit px-6 py-32 md:py-48">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 md:grid-cols-12">
        <p class="label md:col-span-4 md:pt-4">Formules</p>
        <h2 class="heading md:col-span-8">Modalités d’intervention</h2>
      </div>
      <div class="mt-20 grid gap-12 md:mt-28 md:grid-cols-3 md:gap-0">
        {formules.map(([t, d]) => (
          <div class="border-l border-or/35 pl-6 md:px-8">
            <p class="label mb-5">{t}</p>
            <p class="font-serif text-2xl font-light leading-snug text-ivoire">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="s-ivoire px-6 py-32 md:py-48">
    <div class="mx-auto max-w-7xl">
      <blockquote class="quote-xl mx-auto max-w-4xl text-center">« Une présence qui règle le rythme sans jamais le prendre. »</blockquote>
    </div>
  </section>

  <Partners title="Ils nous font déjà confiance" only={['madame-reve','baronne','girafe','too','mun','molitor','polo-de-paris','maison-revka']} />
  <Cta theme="ivoire" />
</Base>
