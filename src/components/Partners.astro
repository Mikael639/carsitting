---
// Défilé des maisons partenaires. Un logo est utilisé s'il est déposé dans public/logos/<identifiant>.(svg|png|webp|jpg) ;
// sinon le nom s'affiche en capitales. Voir public/logos/LISEZ-MOI.md pour la liste des identifiants.
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Partner { name: string; slug: string; scale: number }
const all: Partner[] = [
  { name: 'Madame Rêve', slug: 'madame-reve', scale: 1.5 },
  { name: 'Baronne', slug: 'baronne', scale: 0.8 },
  { name: 'Girafe', slug: 'girafe', scale: 0.9 },
  { name: 'Too', slug: 'too', scale: 1.2 },
  { name: 'Mun', slug: 'mun', scale: 1.0 },
  { name: 'Molitor', slug: 'molitor', scale: 1.15 },
  { name: 'Polo de Paris', slug: 'polo-de-paris', scale: 1.4 },
  { name: 'Maison Revka', slug: 'maison-revka', scale: 1.35 },
  { name: 'Café de l’Homme', slug: 'cafe-de-l-homme', scale: 1.15 },
  { name: 'Thoumieux', slug: 'thoumieux', scale: 1.0 },
  { name: 'Maxim’s', slug: 'maxims', scale: 1.2 },
];
import { getLang, t } from '../i18n';
const ui = t(getLang(Astro.url));
const { only, title = 'Ils nous font confiance' } = Astro.props as { only?: string[]; title?: string };
const dir = join(process.cwd(), 'public', 'logos');
const exts = ['svg', 'png', 'webp', 'jpg'];
const partners = (only ? all.filter((p) => only.includes(p.slug)) : all).map((p) => {
  const ext = exts.find((e) => existsSync(join(dir, `${p.slug}.${e}`)));
  return { ...p, logo: ext ? `/logos/${p.slug}.${ext}` : null };
});
---
<section id="les-maisons" class="s-encre scroll-mt-20 px-6 py-28 text-center md:py-40">
  <p class="label mb-14 md:mb-20">{title}</p>
  <div class="partners-track overflow-hidden" role="list" aria-label={ui.partnersLabel}>
    <ul data-marquee class="flex w-max items-center gap-x-20 pr-20 md:gap-x-28 md:pr-28">
      {partners.map((p) => (
        <li class="partner shrink-0" role="listitem" style={`--s:${p.scale}`}>
          {p.logo
            ? <img src={p.logo} alt={p.name} loading="lazy" class="partner__logo" />
            : <span class="partner__name">{p.name}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>
