---
import { getLang, t, path, norm, alternates } from '../i18n';
const lang = getLang(Astro.url);
const ui = t(lang);
const p = norm(Astro.url.pathname);
const alt = alternates(Astro.url);
const other = lang === 'fr' ? 'en' : 'fr';
---
<header class="site-header fixed inset-x-0 top-0 z-50 border-b">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-4 text-sm sm:px-6 sm:py-5" aria-label={ui.mainNav}>
    <a href={path('home', lang)} class="flex shrink-0 items-center gap-3 whitespace-nowrap" aria-label={ui.logoLabel}>
      <img src="/brand/logo-horizontal-ivoire.png" alt="" width="472" height="98" class="h-[30px] w-auto [filter:drop-shadow(0_1px_10px_rgb(18_25_48/0.6))] sm:h-[34px]" />
    </a>
    <div class="flex items-center gap-4 sm:gap-6 xl:gap-10">
      {ui.nav.map(({ key, label }) => {
        const href = path(key, lang);
        return <a href={href} class="nav-link hidden lg:inline" aria-current={p === norm(href) ? 'page' : undefined}>{label}</a>;
      })}
      <a href={path('quote', lang)} class="btn hidden whitespace-nowrap !px-5 !py-3 sm:inline-block" aria-current={p === norm(path('quote', lang)) ? 'page' : undefined}>{ui.quoteCta}</a>
      <div class="lang-switch hidden sm:flex" role="group" aria-label={ui.language}>
        <span class="lang-switch__current" aria-current="true">{lang.toUpperCase()}</span>
        <span aria-hidden="true">/</span>
        <a href={alt[other]} hreflang={other} lang={other} data-lang-switch={other} title={ui.switchTo}>{other.toUpperCase()}</a>
      </div>
      <button type="button" data-menu-toggle class="menu-toggle lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label={ui.openMenu} data-label-open={ui.openMenu} data-label-close={ui.closeMenu}>
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
      </button>
    </div>
  </nav>
</header>
