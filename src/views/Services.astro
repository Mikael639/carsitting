---
// Nos services / Our services — mise en page unique, textes en français et en anglais.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import Cta from '../components/Cta.astro';
import { getLang, path, t } from '../i18n';

const lang = getLang(Astro.url);
const ui = t(lang);
const copy = {
  fr: {
    title: 'Nos services — CarSitting',
    description: 'Un service voiturier décliné pour chaque maison : hôtels, restaurants et événements privés. À l’année, ponctuel ou événementiel, avec le même niveau d’exigence.',
    heroLabel: 'Nos services',
    heroTitle: 'Un service, décliné pour chaque maison.',
    heroQuote: 'Le même standard d’excellence, adapté à la nature de votre établissement.',
    philosophyLabel: 'Notre philosophie',
    philosophyTitle: 'Un seul niveau d’exigence, quelle que soit la prestation.',
    philosophyText: 'De l’arrivée d’un hôte à la fin d’une soirée, chaque geste est tenu avec la même précision. Votre maison reste au premier plan.',
    services: [
      ['I', 'Hôtels', 'Un accueil sans rupture, du perron à la chambre. Gestion continue des arrivées et des départs, présence discrète, coordination avec votre réception.', 'Piscine et façade d’un hôtel parisien'],
      ['II', 'Restaurants', 'Une dépose précise et une circulation fluide aux heures de pointe. Vos clients accueillis, vos abords dégagés, aucun frottement visible.', 'Terrasse de restaurant face à la tour Eiffel'],
      ['III', 'Événements privés', 'Via votre établissement, un dispositif sur-mesure : équipe dimensionnée, arrivées multiples orchestrées, un protocole invisible pour vos invités.', 'Voituriers accueillant une invitée lors d’une soirée privée'],
    ],
    formulasLabel: 'Formules',
    formulasTitle: 'Modalités d’intervention',
    formulas: [['À l’année', 'Une présence intégrée au rythme de votre maison.'], ['Ponctuel', 'Une équipe préparée pour vos séquences choisies.'], ['Événementiel', 'Un protocole calibré pour vos temps forts.']],
    quote: '« Une présence qui règle le rythme sans jamais le prendre. »',
    partners: 'Ils nous font déjà confiance',
  },
  en: {
    title: 'Our services — CarSitting',
    description: 'A valet service tailored to every house: hotels, restaurants and private events. Year-round, occasional or for events, with the same standard of excellence.',
    heroLabel: 'Our services',
    heroTitle: 'One service, tailored to every house.',
    heroQuote: 'The same standard of excellence, adapted to the nature of your establishment.',
    philosophyLabel: 'Our philosophy',
    philosophyTitle: 'One standard of excellence, whatever the service.',
    philosophyText: 'From a guest’s arrival to the end of an evening, every gesture is delivered with the same precision. Your house always comes first.',
    services: [
      ['I', 'Hotels', 'A seamless welcome, from the front steps to the room. Continuous handling of arrivals and departures, a discreet presence, coordination with your front desk.', 'Pool and façade of a Parisian hotel'],
      ['II', 'Restaurants', 'Precise drop-offs and smooth flow at peak hours. Your guests welcomed, your surroundings kept clear, no visible friction.', 'Restaurant terrace facing the Eiffel Tower'],
      ['III', 'Private events', 'Arranged through your establishment: a bespoke set-up, a team sized to the occasion, multiple arrivals orchestrated, a protocol invisible to your guests.', 'Valets welcoming a guest at a private evening'],
    ],
    formulasLabel: 'Formats',
    formulasTitle: 'Ways of working',
    formulas: [['Year-round', 'A presence woven into the rhythm of your house.'], ['Occasional', 'A team prepared for the moments you choose.'], ['Events', 'A protocol calibrated for your key moments.']],
    quote: '“A presence that sets the rhythm without ever taking it over.”',
    partners: 'They already trust us',
  },
}[lang];
const media = ['/images/services-hotel.jpg', '/images/services-restaurant.webp', '/images/services-evenement.jpg'];
---
<Base title={copy.title} description={copy.description}>
  <Hero
    slides={[{ src: '/images/services-evenement.jpg', position: 'center 35%' }]}
    label={copy.heroLabel}
    title={copy.heroTitle}
    quote={copy.heroQuote}
    cta={{ href: path('quote', lang), label: ui.quote }}
  />

  <section class="s-ivoire px-6 pb-8 pt-14 text-center md:pb-10 md:pt-20">
    <p class="label mb-10">{copy.philosophyLabel}</p>
    <h2 class="quote-xl mx-auto max-w-4xl not-italic">{copy.philosophyTitle}</h2>
    <p class="lede mx-auto mt-10 text-ivoire-muted">{copy.philosophyText}</p>
  </section>

  {/* Prestations : grandes images, alternées gauche / droite. */}
  <section class="s-ivoire px-6 pb-14 md:pb-20">
    <div class="mx-auto max-w-7xl space-y-12 md:space-y-16">
      {copy.services.map(([n, title, text, alt], i) => (
        <article class="card grid items-center gap-10 md:grid-cols-12 md:gap-10">
          <div class:list={['card-media overflow-hidden md:col-span-7', i % 2 === 1 && 'md:order-2 md:col-start-6']}>
            <img src={media[i]} alt={alt} loading="lazy" class="aspect-[4/3] w-full object-cover md:aspect-[5/4]" />
          </div>
          <div class:list={['md:col-span-4', i % 2 === 1 ? 'md:order-1 md:col-start-1' : 'md:col-start-9']}>
            <p class="font-serif text-6xl font-light italic text-or">{n}</p>
            <h3 class="mt-6 font-serif text-4xl font-normal leading-tight text-nuit">{title}</h3>
            <p class="mt-5 text-ivoire-muted">{text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="s-nuit px-6 py-14 md:py-20">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 md:grid-cols-12">
        <p class="label md:col-span-4 md:pt-4">{copy.formulasLabel}</p>
        <h2 class="heading md:col-span-8">{copy.formulasTitle}</h2>
      </div>
      <div class="mt-10 grid gap-8 md:mt-12 md:grid-cols-3 md:gap-0">
        {copy.formulas.map(([title, text]) => (
          <div class="border-l border-or/35 pl-6 md:px-8">
            <p class="label mb-5">{title}</p>
            <p class="font-serif text-2xl font-light leading-snug text-ivoire">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="s-ivoire px-6 py-14 md:py-20">
    <div class="mx-auto max-w-7xl">
      <blockquote class="quote-xl mx-auto max-w-4xl text-center">{copy.quote}</blockquote>
    </div>
  </section>

  <Partners title={copy.partners} only={['paris-society', 'madame-reve', 'baronne', 'girafe', 'too', 'mun', 'molitor', 'polo-de-paris', 'maison-revka']} />
  <Cta theme="ivoire" />
</Base>
